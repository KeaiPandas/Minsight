# Minsight Deploy production environment template.
# Copy values into your hosting platform secret manager or container env.
# Do not commit real secrets.

MINSIGHT_HOST=0.0.0.0
MINSIGHT_PORT=8788
MINSIGHT_CONFIG_MODE=production
MINSIGHT_DB_PATH=/var/lib/minsight/minsight_deploy.sqlite

# OpenAI-compatible model profiles.
LLM_LIGHT_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_LIGHT_API_KEY=your-light-api-key
LLM_LIGHT_MODEL=your-light-model

LLM_STANDARD_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_STANDARD_API_KEY=your-standard-api-key
LLM_STANDARD_MODEL=your-standard-model

LLM_STRONG_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_STRONG_API_KEY=your-strong-api-key
LLM_STRONG_MODEL=your-strong-model

AGENT_NORMALIZE=light
AGENT_REPAIR=light
AGENT_KEYPOINTS=standard
AGENT_ACTIONS_DECISIONS=strong

# Safe default: no external writes.
MINSIGHT_FEISHU_SYNC_MODE=dry_run
MINSIGHT_FEISHU_BASE_SYNC_MODE=dry_run

# Local lark-cli mode is for demos/development. Production OpenAPI adapter is a
# later V4 task.
# MINSIGHT_FEISHU_SYNC_MODE=lark_cli
# MINSIGHT_FEISHU_BASE_SYNC_MODE=lark_cli
# MINSIGHT_FEISHU_IDENTITY=user
# MINSIGHT_FEISHU_RESOLVE_ASSIGNEE=false
# MINSIGHT_FEISHU_TASKLIST_ID=
# MINSIGHT_FEISHU_BASE_TOKEN=
# MINSIGHT_FEISHU_DECISIONS_TABLE_ID=
