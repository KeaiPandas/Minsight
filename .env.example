# ============================================================
#  模型配置：复制本文件为 .env 后填写（.env 请勿提交到仓库）
# ============================================================
#
# 一、定义“模型档位 profile”：本项目按三档路由。每档一套 OpenAI 兼容的 base_url / api_key / model。
#     - light   ：最轻量/最便宜快，做纯抽取、格式修复等无需推理的活
#     - standard：中档均衡，做要点归纳等
#     - strong  ：强推理，做待办+决策等需要判断的活
#     profile 名可自定义；至少配置一个可用 profile，否则程序启动即报错。
#     说明：用的是“OpenAI 兼容”协议，不代表必须使用 OpenAI 模型。
#
LLM_LIGHT_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_LIGHT_API_KEY=your-light-api-key
LLM_LIGHT_MODEL=your-light-model

LLM_STANDARD_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_STANDARD_API_KEY=your-standard-api-key
LLM_STANDARD_MODEL=your-standard-model

LLM_STRONG_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_STRONG_API_KEY=your-strong-api-key
LLM_STRONG_MODEL=your-strong-model
#
# 需要更多 profile，照上面格式加：LLM_<NAME>_BASE_URL / _API_KEY / _MODEL
#
# 二、把每个 Agent 路由到某个 profile（值填 profile 名）。这就是“哪个模型用在哪个 Agent 上”。
#     不填则用内置默认路由（见下方注释）。
#
AGENT_NORMALIZE=light             # 说话人/角色归一（最轻）
AGENT_REPAIR=light                # 校验自修复（照错改格式）
AGENT_KEYPOINTS=standard          # 要点抽取（归纳类）
AGENT_ACTIONS_DECISIONS=strong    # 待办 + 决策（需推理）
AGENT_V1=strong                   # V1 单次调用（基线）
AGENT_LAB_JUDGE=strong            # Lab 评委（LLM judge）
